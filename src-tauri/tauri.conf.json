{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "4GHz",
  "version": "1.1.0",
  "identifier": "io.github.dev1f965x.fourghz",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "4GHz",
        "width": 920,
        "height": 640,
        "decorations": false,
        "minWidth": 560,
        "minHeight": 420,
        "backgroundColor": "#0e0f13"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean",
          "English"
        ],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "uninstallerHeaderImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZEQkUzODZEMEY0MjJGRDkKUldUWkwwSVBiVGkrL1Q1NFJSem9WbW9OWVMyWm9Xekc0U1BsNHlGa2tpaE84UWZwS3pZcmpmVWUK",
      "endpoints": [
        "https://github.com/dev1f965x/4ghz/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
