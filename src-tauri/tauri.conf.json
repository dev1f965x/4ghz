{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "4ghz",
  "mainBinaryName": "4ghz",
  "version": "../package.json",
  "identifier": "io.github.dev1f965x.4ghz",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm notices && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "4ghz",
        "width": 1120,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://dev1f965x.github.io https://api.github.com; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Cocos Nucifera",
    "copyright": "Copyright (c) 2026 Cocos Nucifera",
    "shortDescription": "Schedules, redeem codes, and a chore calendar",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Korean"]
      }
    }
  }
}
