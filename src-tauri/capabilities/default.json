{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window. Each feature adds only the permissions it needs.",
  "windows": ["main"],
  "permissions": [
    "allow-read-store",
    "allow-write-store",
    "allow-data-folder-name",
    "allow-open-data-folder",
    "log:allow-log",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "clipboard-manager:allow-write-text",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://hoyoverse.com/*" },
        { "url": "https://www.hoyoverse.com/*" },
        { "url": "https://genshin.hoyoverse.com/*" },
        { "url": "https://hsr.hoyoverse.com/*" },
        { "url": "https://zenless.hoyoverse.com/*" },
        { "url": "https://hoyolab.com/*" },
        { "url": "https://www.hoyolab.com/*" },
        { "url": "https://github.com/dev1f965x/4ghz/issues" },
        { "url": "https://github.com/dev1f965x/4ghz/releases/tag/v*" }
      ]
    }
  ]
}
