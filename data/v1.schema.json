{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "$schema": {
          "$ref": "#/$defs/__schema0"
        },
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "retired": {
          "type": "boolean",
          "const": true
        },
        "updatedAt": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": [
        "schemaVersion",
        "retired",
        "updatedAt"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "$schema": {
          "$ref": "#/$defs/__schema0"
        },
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "updatedAt": {
          "$ref": "#/$defs/__schema1"
        },
        "games": {
          "type": "object",
          "properties": {
            "genshin": {
              "$ref": "#/$defs/__schema2"
            },
            "hsr": {
              "$ref": "#/$defs/__schema2"
            },
            "zzz": {
              "$ref": "#/$defs/__schema2"
            }
          },
          "required": [
            "genshin",
            "hsr",
            "zzz"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "updatedAt",
        "games"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "__schema0": {
      "type": "string"
    },
    "__schema1": {
      "type": "string"
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "schedule": {
          "$ref": "#/$defs/__schema3"
        },
        "codes": {
          "$ref": "#/$defs/__schema15"
        },
        "chores": {
          "$ref": "#/$defs/__schema16"
        },
        "periods": {
          "$ref": "#/$defs/__schema17"
        }
      },
      "required": [
        "schedule",
        "codes",
        "chores",
        "periods"
      ],
      "additionalProperties": false
    },
    "__schema3": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/__schema4"
              },
              "title": {
                "$ref": "#/$defs/__schema5"
              },
              "url": {
                "$ref": "#/$defs/__schema6"
              },
              "estimated": {
                "$ref": "#/$defs/__schema7"
              },
              "type": {
                "type": "string",
                "enum": [
                  "livestream",
                  "update",
                  "maintenance"
                ]
              },
              "start": {
                "$ref": "#/$defs/__schema8"
              },
              "end": {
                "$ref": "#/$defs/__schema8"
              }
            },
            "required": [
              "id",
              "title",
              "type",
              "start"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/__schema4"
              },
              "title": {
                "$ref": "#/$defs/__schema5"
              },
              "url": {
                "$ref": "#/$defs/__schema6"
              },
              "estimated": {
                "$ref": "#/$defs/__schema7"
              },
              "type": {
                "type": "string",
                "const": "event"
              },
              "start": {
                "$ref": "#/$defs/__schema11"
              },
              "end": {
                "$ref": "#/$defs/__schema11"
              }
            },
            "required": [
              "id",
              "title",
              "type",
              "start"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "__schema4": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "__schema5": {
      "type": "object",
      "properties": {
        "ko": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "ko"
      ],
      "additionalProperties": false
    },
    "__schema6": {
      "type": "string",
      "format": "uri"
    },
    "__schema7": {
      "type": "boolean",
      "const": true
    },
    "__schema8": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/__schema9"
        },
        "at": {
          "$ref": "#/$defs/__schema10"
        }
      },
      "required": [
        "kind",
        "at"
      ],
      "additionalProperties": false
    },
    "__schema9": {
      "type": "string",
      "const": "instant"
    },
    "__schema10": {
      "type": "string"
    },
    "__schema11": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema8"
        },
        {
          "$ref": "#/$defs/__schema12"
        }
      ]
    },
    "__schema12": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/__schema13"
        },
        "at": {
          "$ref": "#/$defs/__schema14"
        }
      },
      "required": [
        "kind",
        "at"
      ],
      "additionalProperties": false
    },
    "__schema13": {
      "type": "string",
      "const": "server"
    },
    "__schema14": {
      "type": "string"
    },
    "__schema15": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]+$"
          },
          "rewards": {
            "$ref": "#/$defs/__schema5"
          },
          "addedAt": {
            "$ref": "#/$defs/__schema1"
          },
          "expires": {
            "$ref": "#/$defs/__schema11"
          }
        },
        "required": [
          "code",
          "rewards",
          "addedAt"
        ],
        "additionalProperties": false
      }
    },
    "__schema16": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema4"
          },
          "name": {
            "$ref": "#/$defs/__schema5"
          },
          "cycle": {
            "type": "string",
            "enum": [
              "daily",
              "weekly",
              "periodic"
            ]
          },
          "enabledByDefault": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "cycle",
          "enabledByDefault"
        ],
        "additionalProperties": false
      }
    },
    "__schema17": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema4"
          },
          "choreId": {
            "$ref": "#/$defs/__schema4"
          },
          "start": {
            "$ref": "#/$defs/__schema12"
          },
          "end": {
            "$ref": "#/$defs/__schema12"
          }
        },
        "required": [
          "id",
          "choreId",
          "start",
          "end"
        ],
        "additionalProperties": false
      }
    }
  }
}
