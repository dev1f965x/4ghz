{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev1f965x.github.io/4ghz/schema.json",
  "title": "4GHz event feed",
  "type": "object",
  "required": ["schemaVersion", "publishedAt", "events", "dailies"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "description": "MAJOR.MINOR. A new MAJOR means older apps must update before reading.",
      "type": "string",
      "pattern": "^[0-9]+[.][0-9]+$"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "codes": {
      "description": "Added in 1.1. Apps on 1.0 ignore it.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/code"
      }
    },
    "dailies": {
      "description": "Added in 1.2. Apps on 1.1 and older ignore it; without it, apps use the chores they were built with.",
      "type": "object",
      "required": ["genshin", "starrail", "zenless"],
      "additionalProperties": false,
      "properties": {
        "genshin": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/chore"
          }
        },
        "starrail": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/chore"
          }
        },
        "zenless": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/chore"
          }
        }
      }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "required": ["id", "game", "kind", "title", "startsAt"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "game": {
          "enum": ["genshin", "starrail", "zenless"]
        },
        "kind": {
          "enum": ["livestream", "version", "maintenance", "ingame"]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "startsAt": {
          "description": "UTC instant, as decided in ADR 7.",
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "endsAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "note": {
          "type": "string",
          "description": "For editors. The app ignores it."
        }
      }
    },
    "code": {
      "type": "object",
      "required": ["code", "game", "rewards", "addedAt"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9]+$"
        },
        "game": {
          "enum": ["genshin", "starrail", "zenless"]
        },
        "rewards": {
          "type": "string",
          "minLength": 1,
          "description": "Shown as written, in Korean."
        },
        "addedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "description": "When it went into the feed. Newest is listed first."
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "source": {
          "type": "string",
          "format": "uri",
          "description": "Where the code was announced. For editors."
        },
        "note": {
          "type": "string",
          "description": "For editors. The app ignores it."
        }
      }
    },
    "chore": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9-]+$",
          "description": "Stable. Players' checks are recorded under it; never reuse or rename one."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Shown as written, in Korean."
        },
        "from": {
          "type": "string",
          "format": "date",
          "description": "First game day it is due, YYYY-MM-DD. A game day starts at 04:00 UTC+8."
        },
        "until": {
          "type": "string",
          "format": "date",
          "description": "Last game day it is due. Set this to retire a chore instead of deleting it."
        },
        "note": {
          "type": "string",
          "description": "For editors. The app ignores it."
        }
      }
    }
  }
}
