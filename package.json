{
  "name": "4ghz",
  "private": true,
  "version": "1.2.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "feed:validate": "tsx scripts/validate-feed.ts",
    "test:timezones": "cross-env TZ=America/New_York vitest run src/domain/schedule.test.ts",
    "check:tauri": "tsx scripts/check-tauri-versions.ts",
    "art:installer": "tsx scripts/draw-installer-art.ts",
    "screens": "tsx scripts/screens.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-http": "^2.6.1",
    "@tauri-apps/plugin-opener": "~2.5.0",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@tauri-apps/plugin-store": "^2.4.5",
    "@tauri-apps/plugin-updater": "~2.12.0",
    "overlayscrollbars": "^2.16.0",
    "overlayscrollbars-react": "^0.5.6",
    "pretendard": "^1.3.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^5.0.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cross-env": "^10.1.0",
    "jsdom": "^30.1.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.0.16",
    "vitest": "^5.0.1"
  },
  "description": "Desktop app that counts down to official Genshin Impact, Honkai: Star Rail, and Zenless Zone Zero events."
}
