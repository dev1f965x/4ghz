{
  "name": "4ghz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "test": "vitest run --passWithNoTests",
    "license-check": "node scripts/check-licenses.mjs",
    "notices": "node scripts/notices.mjs",
    "tokens": "node scripts/tokens.mjs",
    "content-check": "node scripts/check-content.mjs",
    "format": "biome check --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "check": "biome check . && pnpm typecheck && knip && node scripts/tokens.mjs --check && node scripts/check-design-tokens.mjs && pwsh -NoProfile -File design/visual/check-colors.ps1 && pnpm content-check && pnpm test && pnpm license-check && pnpm audit --prod --audit-level high && cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml && cargo deny --manifest-path src-tauri/Cargo.toml check"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "i18next": "^26.4.2",
    "lucide-react": "^1.52.0",
    "pretendard": "^1.3.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.15",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^24.19.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "knip": "^6.39.0",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.0.16",
    "vitest": "^5.0.3"
  }
}
